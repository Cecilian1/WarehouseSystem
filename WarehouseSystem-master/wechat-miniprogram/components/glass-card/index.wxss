.glass-card {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-soft);
  backdrop-filter: blur(22px);
  transition: transform .28s ease, box-shadow .28s ease;
}

.glass-card.tap-scale:active {
  box-shadow: var(--shadow);
}

.glass-card::before {
  display: none;
}

.padding-normal {
  padding: 28rpx;
}

.padding-small {
  padding: 20rpx;
}

.padding-none {
  padding: 0;
}

.tone-deep {
  color: #fff;
  border-color: rgba(255, 255, 255, .2);
  background: linear-gradient(135deg, var(--blue), #38bdf8);
  box-shadow: 0 18rpx 42rpx rgba(79, 140, 255, .22);
}

.tone-env {
  color: #fff;
  border-color: rgba(255, 255, 255, .2);
  background: linear-gradient(135deg, #0f766e, #22d3ee);
  box-shadow: 0 18rpx 42rpx rgba(20, 184, 166, .22);
}

.tone-offline {
  color: #fff;
  border-color: rgba(255, 255, 255, .16);
  background: linear-gradient(135deg, #1e3a5f, #64748b);
  box-shadow: 0 18rpx 42rpx rgba(30, 58, 95, .18);
}

.tone-warn {
  color: #fff;
  border-color: rgba(255, 255, 255, .22);
  background: linear-gradient(135deg, #d97706, #fbbf24);
  box-shadow: 0 18rpx 42rpx rgba(217, 119, 6, .2);
}

.tap-scale {
  transition: transform .18s ease, opacity .18s ease;
}

.tap-scale:active {
  transform: scale(.98);
  opacity: .88;
}
