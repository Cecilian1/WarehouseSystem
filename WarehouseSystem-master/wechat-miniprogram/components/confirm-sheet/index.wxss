.sheet-mask {
  position: fixed;
  z-index: 90;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(10, 14, 20, .5);
  backdrop-filter: blur(10rpx);
}

.sheet-panel {
  width: 100%;
  padding: 18rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  border: 1rpx solid var(--stroke);
  background: var(--surface-strong);
  box-shadow: var(--shadow);
  backdrop-filter: blur(24px);
}

.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 99rpx;
  background: var(--stroke-strong);
}

.sheet-title {
  color: var(--text-1);
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
}

.sheet-desc {
  margin: 16rpx 18rpx 30rpx;
  color: var(--text-3);
  font-size: 28rpx;
  line-height: 1.55;
  text-align: center;
}

.sheet-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
