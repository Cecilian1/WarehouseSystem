page {
  --blue: #4f8cff;
  --cyan: #38bdf8;
  --teal: #14b8a6;
  --green: #22c55e;
  --orange: #f59e0b;
  --red: #ef4444;
  --purple: #8b7cff;
  --radius-lg: 44rpx;
  --radius-md: 32rpx;
  --radius-sm: 22rpx;
  --radius-pill: 999rpx;
  min-height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

.theme-dark {
  --bg-0: #07111f;
  --bg-1: #0d1728;
  --bg-2: #111f33;
  --surface: rgba(16, 31, 52, .68);
  --surface-strong: rgba(20, 37, 61, .86);
  --surface-soft: rgba(255, 255, 255, .055);
  --stroke: rgba(148, 163, 184, .16);
  --stroke-strong: rgba(148, 163, 184, .28);
  --text-1: #f4f8ff;
  --text-2: #a8b7ca;
  --text-3: #70829a;
  --shadow: 0 44rpx 140rpx rgba(0, 0, 0, .28);
  --shadow-soft: 0 20rpx 56rpx rgba(0, 0, 0, .16);
  display: block;
  min-height: 100%;
  color: var(--text-2);
  background: linear-gradient(140deg, var(--bg-0), var(--bg-1) 48%, var(--bg-2));
}

.theme-light {
  --bg-0: #eef4fa;
  --bg-1: #f6f9fc;
  --bg-2: #ffffff;
  --surface: rgba(255, 255, 255, .74);
  --surface-strong: rgba(255, 255, 255, .94);
  --surface-soft: rgba(15, 23, 42, .035);
  --stroke: rgba(100, 116, 139, .18);
  --stroke-strong: rgba(100, 116, 139, .32);
  --text-1: #16263d;
  --text-2: #59708d;
  --text-3: #8b9bb0;
  --shadow: 0 44rpx 140rpx rgba(32, 62, 91, .12);
  --shadow-soft: 0 20rpx 56rpx rgba(32, 62, 91, .08);
  display: block;
  min-height: 100%;
  color: var(--text-2);
  background: linear-gradient(140deg, var(--bg-0), var(--bg-1) 48%, var(--bg-2));
}

view,
text,
scroll-view,
swiper,
button,
input {
  box-sizing: border-box;
}

button {
  padding: 0;
  border: 0;
  color: inherit;
  line-height: inherit;
  text-align: inherit;
  background: transparent;
}

button::after {
  border: 0;
}

.page-shell {
  position: relative;
  min-height: 100vh;
  padding: 0 28rpx calc(156rpx + env(safe-area-inset-bottom));
}

.nav-spacer {
  height: var(--nav-height, 104rpx);
}

.custom-nav {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding-top: var(--status-top, 44rpx);
}

.nav-back {
  display: grid;
  width: 68rpx;
  height: 68rpx;
  margin-right: 12rpx;
  place-items: center;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-sm);
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}

.page-title {
  position: relative;
  z-index: 2;
  margin: 0;
  color: var(--text-1);
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.page-subtitle {
  position: relative;
  z-index: 2;
  margin-top: 10rpx;
  color: var(--text-3);
  font-size: 26rpx;
  line-height: 1.5;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin: 30rpx 0 16rpx;
}

.section-head__title {
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 800;
}

.section-head__more {
  color: var(--cyan);
  font-size: 24rpx;
  font-weight: 700;
}

.primary-button,
.ghost-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  gap: 10rpx;
  border-radius: var(--radius-sm);
  font-size: 28rpx;
  font-weight: 800;
}

.primary-button {
  color: #fff;
  background: linear-gradient(135deg, var(--blue), #38bdf8);
  box-shadow: 0 14rpx 34rpx rgba(79, 140, 255, .22);
}

.ghost-button {
  color: var(--text-1);
  background: var(--surface-soft);
  border: 1rpx solid var(--stroke);
}

.danger-button {
  color: #fff;
  background: linear-gradient(135deg, var(--orange), var(--red));
}

.tap-scale {
  transition: transform .18s ease, opacity .18s ease;
}

.tap-scale:active {
  transform: scale(.975);
  opacity: .86;
}

.fade-up {
  animation: fadeUp .42s ease both;
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(22rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.pulse-soft {
  animation: pulseSoft 1.8s ease-in-out infinite;
}

@keyframes pulseSoft {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(245, 158, 11, .28);
  }
  50% {
    box-shadow: 0 0 0 18rpx rgba(245, 158, 11, 0);
  }
}

.leaf-mark {
  position: absolute;
  width: 130rpx;
  height: 74rpx;
  border-radius: 80rpx 0 80rpx 0;
  border: 1rpx solid rgba(255, 255, 255, .36);
  opacity: .35;
  transform: rotate(-22deg);
}
