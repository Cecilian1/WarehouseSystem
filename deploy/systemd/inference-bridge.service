[Unit]
Description=WarehouseKeeper inference bridge
After=camera-service.service ai-service-cpp.service
Wants=camera-service.service ai-service-cpp.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=__WAREHOUSE_ROOT__
Environment=WAREHOUSE_DB_PATH=/data/warehousekeeper/warehousekeeper.db
Environment=WAREHOUSE_INFERENCE_WORKER_DB=/data/warehousekeeper/inference-worker.db
Environment=WAREHOUSE_INFERENCE_BRIDGE_LOCK=/data/warehousekeeper/inference-bridge.lock
ExecStart=/usr/bin/python3 -m backend.inference_bridge.main
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
