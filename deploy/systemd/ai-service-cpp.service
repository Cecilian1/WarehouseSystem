[Unit]
Description=WarehouseKeeper C++ YOLO and Freshness AI Service
After=camera-service.service
Wants=camera-service.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=__WAREHOUSE_ROOT__
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=WAREHOUSE_AI_LOCK=/data/warehousekeeper/warehouse-ai-service.lock
ExecStart=__WAREHOUSE_ROOT__/deploy/run_warehouse_ai_service.sh \
  --db /data/warehousekeeper/inference-worker.db \
  --detector __WAREHOUSE_ROOT__/models/best_ncnn_model \
  --freshness __WAREHOUSE_ROOT__/models/shufflenet_v2_freshness_ncnn_model \
  --crop-dir /data/warehousekeeper/frames/crops \
  --threads 1
Restart=on-failure
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
