[Unit]
Description=WarehouseKeeper YOLO and Freshness AI Service
After=camera-service.service
Requires=camera-service.service

[Service]
Type=simple
WorkingDirectory=/opt/warehousekeeper
Environment=WAREHOUSE_DB_PATH=/data/warehousekeeper/warehousekeeper.db
Environment=WAREHOUSE_YOLO_MODEL_PATH=/opt/warehousekeeper/models/best.onnx
Environment=WAREHOUSE_FRESHNESS_MODEL_PATH=/opt/warehousekeeper/models/shufflenet_v2_freshness.onnx
ExecStart=/usr/bin/python3 -m backend.ai_service.main
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
