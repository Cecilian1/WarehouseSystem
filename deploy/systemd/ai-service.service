[Unit]
Description=WarehouseKeeper YOLO and Freshness AI Service
After=camera-service.service
Requires=camera-service.service

[Service]
Type=simple
WorkingDirectory=__WAREHOUSE_ROOT__
Environment=WAREHOUSE_DB_PATH=/data/warehousekeeper/warehousekeeper.db
Environment=WAREHOUSE_YOLO_MODEL_PATH=__WAREHOUSE_ROOT__/models/best.onnx
Environment=WAREHOUSE_FRESHNESS_MODEL_PATH=__WAREHOUSE_ROOT__/models/shufflenet_v2_freshness.onnx
ExecStart=/usr/bin/python3 -m backend.ai_service.main
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
