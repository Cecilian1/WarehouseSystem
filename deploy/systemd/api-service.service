[Unit]
Description=WarehouseKeeper Web API Service
After=network.target

[Service]
Type=simple
WorkingDirectory=__WAREHOUSE_ROOT__
# 可选加载仓库根目录的后端密钥与模型配置；文件不存在时仍可启动并使用本地兜底报告。
EnvironmentFile=-__WAREHOUSE_ROOT__/.env
Environment=WAREHOUSE_DB_PATH=/data/warehousekeeper/warehousekeeper.db
Environment=WAREHOUSE_CORS_ORIGINS=*
# 仓库根目录 .env 同时供 Windows 汇总端使用，其中可能包含电脑端数据库路径
# 和板端地址。通过 /usr/bin/env 在最终启动命令中锁定板端资源，避免 API
# 读取错误数据库或把图片请求递归代理回自身。
ExecStart=/usr/bin/env WAREHOUSE_DB_PATH=/data/warehousekeeper/warehousekeeper.db WAREHOUSE_LATEST_FRAME_PATH=/data/warehousekeeper/frames/latest.jpg WAREHOUSE_BOARD_SOURCE_URL= /usr/bin/python3 -m uvicorn backend.api_service.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
