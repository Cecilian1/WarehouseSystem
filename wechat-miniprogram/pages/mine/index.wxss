.user-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 24rpx;
  padding: 32rpx;
  border-radius: var(--radius-lg);
  color: #fff;
  background: linear-gradient(135deg, #4f8cff, #6c63ff 56%, #38bdf8);
  box-shadow: 0 24rpx 60rpx rgba(79, 140, 255, .24);
}

.avatar {
  display: grid;
  width: 108rpx;
  height: 108rpx;
  place-items: center;
  border: 2rpx solid rgba(255, 255, 255, .42);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, .2);
}

.avatar view {
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  border-bottom-color: rgba(255, 255, 255, .5);
}

.user-copy {
  min-width: 0;
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 900;
}

.family-name {
  margin-top: 8rpx;
  font-size: 25rpx;
  opacity: .82;
}

.mine-shortcuts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.mine-shortcuts button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 94rpx;
  gap: 10rpx;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-md);
  color: var(--text-2);
  font-size: 27rpx;
  font-weight: 900;
  background: var(--surface);
}

.setting-group {
  margin-top: 8rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 116rpx;
  padding: 0 24rpx;
}

.setting-row + .setting-row {
  border-top: 1rpx solid var(--stroke);
}

.setting-icon {
  display: grid;
  width: 66rpx;
  height: 66rpx;
  place-items: center;
  border-radius: var(--radius-sm);
  color: var(--text-2);
  background: var(--surface-soft);
}

.theme-icon-shape {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid var(--stroke-strong);
  border-radius: 50%;
  background: linear-gradient(135deg, var(--blue) 50%, transparent 50%);
}

.setting-copy {
  min-width: 0;
  flex: 1;
}

.setting-copy view {
  color: var(--text-1);
  font-size: 28rpx;
  font-weight: 900;
}

.setting-copy text {
  display: block;
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.threshold-row {
  margin-bottom: 26rpx;
}

.threshold-row:last-of-type {
  margin-bottom: 18rpx;
}

.threshold-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.threshold-label text {
  color: var(--text-2);
  font-size: 25rpx;
  font-weight: 700;
}

.threshold-label .threshold-value {
  color: var(--text-1);
  font-weight: 900;
}

.connection-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--stroke);
}

.connection-row label {
  color: var(--text-3);
  font-size: 24rpx;
}

.connection-row text {
  overflow: hidden;
  color: var(--text-1);
  font-size: 24rpx;
  font-weight: 800;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.connection-stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.connection-stepper text {
  min-width: 100rpx;
}

.stepper-btn {
  display: grid;
  width: 48rpx;
  height: 48rpx;
  place-items: center;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-sm);
  color: var(--text-1);
  font-size: 28rpx;
  font-weight: 900;
  background: var(--surface-soft);
}

.connection-status {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 20rpx 0;
}

.account-row,
.role-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--stroke);
}

.account-name {
  color: var(--text-1);
  font-size: 27rpx;
  font-weight: 900;
}

.account-role {
  margin-left: 8rpx;
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 700;
}

.account-meta {
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 22rpx;
}

.account-add {
  margin-top: 20rpx;
}

.role-main {
  min-width: 0;
  flex: 1;
}

.role-name {
  color: var(--text-1);
  font-size: 27rpx;
  font-weight: 900;
}

.role-desc {
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 22rpx;
}

.role-config {
  flex: 0 0 auto;
  min-width: 140rpx;
  height: 60rpx;
  font-size: 23rpx;
  line-height: 60rpx;
}
