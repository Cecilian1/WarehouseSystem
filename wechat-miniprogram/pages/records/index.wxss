.custom-nav {
  display: flex;
  align-items: center;
}

.search-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border-radius: var(--radius-md);
  color: var(--text-2);
  background: var(--surface);
}

.search-card input {
  flex: 1;
  color: var(--text-1);
  font-size: 28rpx;
}

.type-row {
  margin: 22rpx 0;
  white-space: nowrap;
}

.type-row button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  height: 64rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  color: var(--text-3);
  font-size: 25rpx;
  font-weight: 900;
  background: var(--surface);
}

.type-row .active {
  color: #fff;
  background: linear-gradient(135deg, var(--blue), #6c63ff);
}

.timeline {
  display: grid;
  gap: 18rpx;
}

.record-item {
  position: relative;
  padding-left: 52rpx;
}

.record-item::before {
  position: absolute;
  left: 21rpx;
  top: 58rpx;
  bottom: -22rpx;
  border-left: 2rpx solid var(--stroke);
  content: "";
}

.record-dot {
  position: absolute;
  left: 0;
  top: 26rpx;
  display: grid;
  width: 44rpx;
  height: 44rpx;
  place-items: center;
  border: 4rpx solid var(--bg-2);
  border-radius: 50%;
  color: #fff;
  background: var(--blue);
  box-shadow: 0 0 0 8rpx rgba(79, 140, 255, .12);
}

.record-dot.outbound {
  background: var(--cyan);
}

.record-dot.manual {
  background: var(--purple);
}

.record-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.record-title {
  color: var(--text-1);
  font-size: 29rpx;
  font-weight: 900;
}

.record-time,
.record-meta {
  color: var(--text-3);
  font-size: 23rpx;
}

.record-detail {
  margin-top: 10rpx;
  color: var(--text-2);
  font-size: 27rpx;
  font-weight: 700;
}

.record-meta {
  margin-top: 8rpx;
}

.record-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--stroke);
}

.record-detail-row:last-child {
  border-bottom: 0;
}

.record-detail-row label {
  color: var(--text-3);
  font-size: 25rpx;
}

.record-detail-row text {
  color: var(--text-1);
  font-size: 26rpx;
  font-weight: 800;
}
