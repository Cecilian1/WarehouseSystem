.recognition-page {
  min-height: 100vh;
  color: #f4f8ff;
  background: linear-gradient(165deg, #07111f, #14283f 52%, #1a2f4a);
}

.recognition-bg {
  position: fixed;
  inset: 0;
  background: radial-gradient(circle at 82% 14%, rgba(56, 189, 248, .16), transparent 34%), radial-gradient(circle at 20% 80%, rgba(79, 140, 255, .16), transparent 38%);
}

.recognition-shell {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  padding: 0 28rpx calc(148rpx + env(safe-area-inset-bottom));
}

.custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page-title--on-camera {
  color: #fff;
}

.page-subtitle--on-camera {
  color: rgba(244, 248, 255, .68);
}

.camera-card {
  margin-top: 28rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, .18);
  border-radius: var(--radius-lg);
  background: rgba(7, 17, 31, .6);
  box-shadow: 0 30rpx 70rpx rgba(0, 0, 0, .3);
}

.camera-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.camera-title {
  color: #fff;
  font-size: 31rpx;
  font-weight: 900;
}

.camera-sub {
  margin-top: 6rpx;
  color: rgba(237, 246, 240, .62);
  font-size: 23rpx;
}

.live-dot {
  margin: 0;
  height: 48rpx;
  padding: 0 16rpx;
  border: 0;
  border-radius: var(--radius-pill);
  color: #86efac;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 48rpx;
  background: rgba(34, 197, 94, .16);
}

.live-dot::after {
  border: 0;
}

.camera-stage {
  height: 460rpx;
  overflow: hidden;
  border-radius: var(--radius-md);
  background: #050d1a;
}

.camera-frame {
  position: relative;
  height: 100%;
  overflow: hidden;
  background: #050d1a;
}

.camera-image {
  width: 100%;
  height: 100%;
  background: #050d1a;
}

.image-state {
  position: absolute;
  inset: 0;
  z-index: 4;
  display: grid;
  place-content: center;
  justify-items: center;
  gap: 18rpx;
  color: rgba(244, 248, 255, .74);
  font-size: 23rpx;
  background: rgba(5, 13, 26, .78);
}

.image-state--error {
  color: #fca5a5;
}

.image-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 5rpx solid rgba(148, 215, 255, .18);
  border-top-color: #38bdf8;
  border-radius: 50%;
  animation: spin .8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.detect-box {
  position: absolute;
  border: 3rpx solid #22c55e;
  border-radius: 10rpx;
  box-shadow: 0 0 18rpx rgba(34, 197, 94, .42);
}

.detect-box.mild {
  border-color: #fbbf24;
  box-shadow: 0 0 18rpx rgba(251, 191, 36, .42);
}

.detect-box.expiring {
  border-color: #f59e0b;
  box-shadow: 0 0 18rpx rgba(245, 158, 11, .42);
}

.detect-box.spoiled {
  border-color: #ef4444;
  box-shadow: 0 0 18rpx rgba(239, 68, 68, .42);
}

.detect-box text {
  position: absolute;
  left: -2rpx;
  top: -38rpx;
  padding: 5rpx 10rpx;
  border-radius: 10rpx;
  color: #fff;
  font-size: 20rpx;
  background: rgba(5, 20, 28, .72);
  white-space: nowrap;
}

.scan-line {
  position: absolute;
  left: 0;
  right: 0;
  top: -20%;
  height: 22%;
  background: linear-gradient(180deg, transparent, rgba(56, 189, 248, .32), transparent);
  animation: scan 2.2s ease-in-out infinite;
}

@keyframes scan {
  to {
    top: 100%;
  }
}

.pipeline {
  display: grid;
  gap: 18rpx;
}

.pipeline-step {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.step-mark {
  display: grid;
  width: 54rpx;
  height: 54rpx;
  place-items: center;
  border-radius: 18rpx;
  color: var(--blue);
  background: rgba(79, 140, 255, .14);
}

.step-name {
  color: var(--text-1);
  font-size: 27rpx;
  font-weight: 900;
}

.frame-summary {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.score-ring {
  display: grid;
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 auto;
  place-items: center;
  border: 10rpx solid rgba(79, 140, 255, .18);
  border-top-color: var(--blue);
  border-right-color: var(--blue);
  border-radius: 50%;
}

.score-ring text {
  color: var(--text-1);
  font-size: 30rpx;
  font-weight: 900;
}

.frame-summary-info {
  display: grid;
  flex: 1;
  gap: 10rpx;
}

.frame-summary-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.frame-summary-row label {
  color: var(--text-3);
  font-size: 23rpx;
}

.frame-summary-row text {
  color: var(--text-1);
  font-size: 24rpx;
  font-weight: 800;
}

.latency-trend {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 90rpx;
  margin-top: 24rpx;
}

.latency-bar {
  flex: 1;
  border-radius: 999rpx;
  background: linear-gradient(180deg, var(--cyan), rgba(56, 189, 248, .18));
}

.latency-caption {
  margin-top: 12rpx;
  color: var(--text-3);
  font-size: 21rpx;
}

.step-cost {
  margin-top: 4rpx;
  color: var(--text-3);
  font-size: 22rpx;
}

.section-head--on-camera .section-head__title {
  color: var(--text-1);
}

.target-list {
  display: grid;
  gap: 16rpx;
}

.target-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.target-main {
  flex: 1;
}

.target-name {
  color: var(--text-1);
  font-size: 30rpx;
  font-weight: 900;
}

.target-name text {
  color: var(--teal);
}

.target-meta {
  margin: 8rpx 0 12rpx;
  color: var(--text-3);
  font-size: 23rpx;
}

.target-actions {
  display: grid;
  gap: 12rpx;
}

.target-actions button {
  min-width: 96rpx;
  height: 52rpx;
  border-radius: 18rpx;
  color: var(--teal);
  font-size: 23rpx;
  font-weight: 900;
  background: rgba(20, 184, 166, .14);
  text-align: center;
  line-height: 52rpx;
}

.confirm-recognition {
  margin-top: 28rpx;
}
