.alert-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.stat text,
.stat small {
  display: block;
}

.stat text {
  color: var(--text-1);
  font-size: 42rpx;
  font-weight: 900;
}

.stat small {
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

.stat.warning text {
  color: var(--orange);
}

.stat.critical text {
  color: var(--red);
}

.stat.info text {
  color: var(--cyan);
}

.search-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 88rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-md);
  color: var(--text-2);
  background: var(--surface);
}

.search-card input {
  flex: 1;
  color: var(--text-1);
  font-size: 28rpx;
}

.search-card button {
  color: var(--text-2);
  font-size: 26rpx;
  font-weight: 900;
}

.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 18rpx;
}

.batch-bar text {
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 700;
}

.batch-bar .primary-button {
  min-height: 64rpx;
  padding: 0 28rpx;
}

.filter-row {
  margin-top: 24rpx;
  white-space: nowrap;
}

.filter-row button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  min-width: 116rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  color: var(--text-3);
  font-size: 25rpx;
  font-weight: 900;
  background: var(--surface);
}

.filter-row .active {
  color: #fff;
  background: linear-gradient(135deg, var(--blue), #6c63ff);
}

.group-list {
  display: grid;
  gap: 10rpx;
}

.alert-group {
  display: grid;
  gap: 16rpx;
}

.alert-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.alert-checkbox {
  flex: 0 0 auto;
  transform: scale(.82);
}

.alert-icon {
  display: grid;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 24rpx;
  color: var(--cyan);
  background: rgba(56, 189, 248, .14);
}

.alert-icon.warning {
  color: var(--orange);
  background: rgba(245, 158, 11, .16);
}

.alert-icon.critical {
  color: var(--red);
  background: rgba(239, 68, 68, .16);
}

.alert-main {
  min-width: 0;
  flex: 1;
}

.alert-title {
  color: var(--text-1);
  font-size: 29rpx;
  font-weight: 900;
}

.alert-desc,
.alert-meta {
  overflow: hidden;
  color: var(--text-3);
  font-size: 24rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alert-desc {
  margin-top: 8rpx;
}

.alert-meta {
  margin-top: 5rpx;
}

.alert-side {
  display: grid;
  justify-items: end;
  gap: 12rpx;
}

.alert-actions {
  display: flex;
  gap: 8rpx;
}

.alert-actions button {
  min-width: 78rpx;
  height: 52rpx;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
  line-height: 52rpx;
}

.alert-actions button:first-child {
  color: #fff;
  background: linear-gradient(135deg, var(--blue), #6c63ff);
}

.alert-actions button:last-child {
  color: var(--text-2);
  background: var(--surface-soft);
}
