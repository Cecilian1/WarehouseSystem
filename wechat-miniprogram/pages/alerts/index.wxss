.alert-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.stat text,
.stat small {
  display: block;
}

.stat text {
  color: var(--text-1);
  font-size: 42rpx;
  font-weight: 900;
}

.stat small {
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

.stat.warning text {
  color: var(--orange);
}

.stat.critical text {
  color: var(--red);
}

.stat.info text {
  color: var(--cyan);
}

.search-card {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 88rpx;
  margin-top: 22rpx;
  padding: 8rpx 10rpx 8rpx 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-md);
  color: var(--text-2);
  background: var(--surface);
}

.search-icon {
  display: grid;
  flex: 0 0 auto;
  place-items: center;
}

.search-input {
  min-width: 0;
  flex: 1;
  height: 64rpx;
  color: var(--text-1);
  font-size: 26rpx;
  line-height: 64rpx;
}

.search-placeholder {
  color: var(--text-3);
}

.search-clear {
  display: grid;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 50%;
  color: var(--text-3);
  font-size: 28rpx;
  line-height: 1;
  background: var(--surface-soft);
}

.search-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 96rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #38bdf8, #4f8cff);
}

.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 0 18rpx;
}

.batch-bar text {
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 700;
}

.batch-bar .primary-button {
  min-height: 64rpx;
  padding: 0 28rpx;
}

.filter-panel {
  display: grid;
  gap: 12rpx;
  margin: 20rpx 0 8rpx;
}

.filter-segment {
  display: flex;
  padding: 6rpx;
  border: 1rpx solid var(--stroke);
  border-radius: 16rpx;
  background: var(--surface-soft);
}

.filter-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 8rpx;
  border-radius: 12rpx;
  color: var(--text-3);
  font-size: 24rpx;
  font-weight: 800;
}

.filter-item.active {
  color: #fff;
  background: linear-gradient(135deg, #38bdf8, #4f8cff);
  box-shadow: 0 8rpx 20rpx rgba(79, 140, 255, .22);
}

.group-list {
  display: grid;
  gap: 10rpx;
}

.alert-group {
  display: grid;
  gap: 16rpx;
}

.alert-card {
  min-width: 0;
}

.alert-top {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  min-width: 0;
}

.alert-checkbox {
  flex: 0 0 auto;
  margin-top: 10rpx;
  transform: scale(.78);
}

.alert-icon {
  display: grid;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 auto;
  margin-top: 4rpx;
  place-items: center;
  border-radius: 18rpx;
  color: var(--cyan);
  background: rgba(56, 189, 248, .14);
}

.alert-icon.warning {
  color: var(--orange);
  background: rgba(245, 158, 11, .16);
}

.alert-icon.critical {
  color: var(--red);
  background: rgba(239, 68, 68, .16);
}

.alert-main {
  min-width: 0;
  flex: 1;
}

.alert-title {
  overflow: hidden;
  color: var(--text-1);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alert-desc {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--text-3);
  font-size: 23rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.alert-meta {
  overflow: hidden;
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.alert-tag {
  flex: 0 0 auto;
  margin-top: 4rpx;
}

.alert-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--stroke);
}

.alert-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-height: 64rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.alert-action.ghost {
  color: var(--text-2);
  background: var(--surface-soft);
}

.alert-action.primary {
  color: #fff;
  background: linear-gradient(135deg, #38bdf8, #4f8cff);
}
