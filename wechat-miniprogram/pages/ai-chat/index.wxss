.chat-page {
  height: 100vh;
  padding: 0;
  overflow: hidden;
}

.voice-composer {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  display: grid;
  justify-items: center;
  padding: 20rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--stroke);
  background: var(--surface-strong);
  backdrop-filter: blur(30rpx);
}

.voice-hint { margin-bottom: 18rpx; color: var(--text-2); font-size: 22rpx; font-weight: 650; letter-spacing: 1rpx; }
.voice-button {
  position: relative;
  display: grid;
  width: 136rpx;
  height: 136rpx;
  place-items: center;
  border: 1rpx solid rgba(156, 224, 255, .5);
  border-radius: 50%;
  background: linear-gradient(145deg, #568cff 4%, #2db9eb 54%, #20c8bd 100%);
  box-shadow:
    0 20rpx 46rpx rgba(37, 173, 235, .3),
    0 0 0 8rpx rgba(62, 190, 236, .08),
    inset 0 2rpx 3rpx rgba(255, 255, 255, .42),
    inset 0 -12rpx 24rpx rgba(3, 87, 157, .18);
  transition: transform .16s ease, box-shadow .2s ease, filter .2s ease;
}
.voice-button::before {
  position: absolute;
  inset: 8rpx;
  border: 2rpx solid rgba(255, 255, 255, .22);
  border-radius: 50%;
  content: '';
}
.voice-button::after {
  position: absolute;
  top: 14rpx;
  left: 27rpx;
  width: 52rpx;
  height: 22rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, rgba(255, 255, 255, .36), rgba(255, 255, 255, 0));
  content: '';
  transform: rotate(-18deg);
}
.voice-button:active { transform: scale(.95); }
.voice-button.is-disabled { opacity: .48; filter: saturate(.55); }
.voice-button-surface { position: relative; z-index: 2; width: 80rpx; height: 88rpx; }
.mic-capsule {
  position: absolute;
  top: 2rpx;
  left: 24rpx;
  width: 34rpx;
  height: 54rpx;
  overflow: hidden;
  box-sizing: border-box;
  border: 3rpx solid rgba(255, 255, 255, .92);
  border-radius: 20rpx;
  background: linear-gradient(155deg, #fff 4%, #e8fbff 48%, #baf4ef 100%);
  box-shadow: 0 7rpx 16rpx rgba(3, 72, 128, .2);
}
.mic-highlight {
  width: 9rpx;
  height: 27rpx;
  margin: 6rpx 0 0 7rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, .84);
  transform: rotate(8deg);
}
.mic-cradle {
  position: absolute;
  top: 25rpx;
  left: 14rpx;
  width: 54rpx;
  height: 42rpx;
  box-sizing: border-box;
  border: 5rpx solid #fff;
  border-top: 0;
  border-radius: 0 0 30rpx 30rpx;
  filter: drop-shadow(0 5rpx 6rpx rgba(3, 72, 128, .18));
}
.mic-stem { position: absolute; top: 65rpx; left: 38rpx; width: 5rpx; height: 13rpx; border-radius: 5rpx; background: #fff; }
.mic-base { position: absolute; top: 76rpx; left: 25rpx; width: 31rpx; height: 6rpx; border-radius: 999rpx; background: #fff; box-shadow: 0 4rpx 7rpx rgba(3, 72, 128, .18); }
.voice-wave { position: absolute; width: 158rpx; height: 158rpx; border: 2rpx solid rgba(105, 211, 255, .42); border-radius: 50%; opacity: .18; }
.is-recording .voice-wave { animation: voice-pulse 1.4s ease-out infinite; }
.voice-button.is-recording {
  background: linear-gradient(145deg, #ff6b8a, #ff775f 55%, #f4a74b);
  box-shadow: 0 20rpx 48rpx rgba(255, 103, 104, .34), 0 0 0 9rpx rgba(255, 112, 100, .1), inset 0 2rpx 3rpx rgba(255, 255, 255, .4);
}
.is-recording .mic-capsule { animation: mic-breathe .72s ease-in-out infinite alternate; }
.wave-b { animation-delay: .45s !important; }
.voice-text-composer { width: 100%; margin-top: 22rpx; box-sizing: border-box; }
.voice-composer .composer-tip { margin-top: 10rpx; color: var(--text-3); font-size: 19rpx; }

@keyframes voice-pulse {
  0% { opacity: .6; transform: scale(.78); }
  100% { opacity: 0; transform: scale(1.35); }
}

@keyframes mic-breathe {
  from { transform: scaleY(.94); }
  to { transform: scaleY(1.05); }
}

.chat-nav {
  min-height: 118rpx;
  padding-right: 28rpx;
  padding-left: 28rpx;
  border-bottom: 1rpx solid var(--stroke);
  background: var(--surface);
  backdrop-filter: blur(28rpx);
}

.nav-ai-mark {
  position: relative;
  display: grid;
  width: 62rpx;
  height: 62rpx;
  margin-right: 14rpx;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 21rpx;
  background: linear-gradient(145deg, #4f8cff, #2dd4bf);
  box-shadow: 0 10rpx 26rpx rgba(79, 140, 255, .28);
}

.nav-ai-mark::before,
.nav-ai-mark::after,
.nav-ai-mark view {
  position: absolute;
  border-radius: 999rpx;
  background: #fff;
  content: "";
}

.nav-ai-mark::before { width: 8rpx; height: 34rpx; }
.nav-ai-mark::after { width: 34rpx; height: 8rpx; }
.nav-ai-mark view { width: 9rpx; height: 9rpx; right: 8rpx; top: 8rpx; opacity: .7; }
.nav-copy { min-width: 0; }
.chat-nav .page-title { font-size: 31rpx; }
.chat-nav .page-subtitle { margin-top: 3rpx; font-size: 21rpx; }

.chat-status {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  gap: 10rpx;
  color: var(--text-3);
  font-size: 20rpx;
}

.online-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 12rpx rgba(34, 197, 94, .58);
}

.chat-scroll {
  height: calc(100vh - var(--nav-height) - 222rpx - env(safe-area-inset-bottom));
  padding: 22rpx 26rpx 44rpx;
  box-sizing: border-box;
}

.voice-mode .chat-scroll {
  height: calc(100vh - var(--nav-height) - 390rpx - env(safe-area-inset-bottom));
}

.question-row,
.answer-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.message-block {
  margin-bottom: 28rpx;
}

.question-row {
  justify-content: flex-end;
}

.question-bubble {
  max-width: 520rpx;
  padding: 20rpx 24rpx;
  color: #fff;
  border-radius: 28rpx 8rpx 28rpx 28rpx;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 1.6;
  background: linear-gradient(135deg, #4f8cff, #38bdf8);
  box-shadow: 0 12rpx 30rpx rgba(79, 140, 255, .2);
}

.user-avatar,
.assistant-avatar {
  display: grid;
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 auto;
  place-items: center;
  color: #fff;
  border-radius: 21rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.user-avatar { background: linear-gradient(145deg, #8b7cff, #4f8cff); }
.assistant-avatar { position: relative; background: linear-gradient(145deg, #4f8cff, #2dd4bf); }
.avatar-eye { position: absolute; top: 23rpx; width: 5rpx; height: 5rpx; border-radius: 50%; background: #fff; }
.avatar-eye.left { left: 18rpx; }
.avatar-eye.right { right: 18rpx; }
.avatar-smile { position: absolute; left: 23rpx; bottom: 15rpx; width: 14rpx; border-top: 3rpx solid #fff; border-radius: 50%; }

.answer-wrap { min-width: 0; flex: 1; }
.answer-card { padding: 24rpx; border: 1rpx solid var(--stroke); border-radius: 8rpx 30rpx 30rpx 30rpx; background: var(--surface-strong); box-shadow: var(--shadow-soft); }
.answer-card.answer-high { border-color: rgba(239, 68, 68, .25); }
.answer-card.answer-attention { border-color: rgba(245, 158, 11, .25); }

.answer-head { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; }
.answer-title { color: var(--text-1); font-size: 26rpx; font-weight: 900; }
.urgency-pill { display: flex; align-items: center; min-height: 42rpx; padding: 0 13rpx; gap: 8rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 850; }
.urgency-pill i { width: 9rpx; height: 9rpx; border-radius: 50%; background: currentColor; }
.urgency-normal { color: #22c55e; background: rgba(34, 197, 94, .1); }
.urgency-attention { color: #f59e0b; background: rgba(245, 158, 11, .1); }
.urgency-high { color: #ef4444; background: rgba(239, 68, 68, .1); }

.answer-summary { margin-top: 18rpx; color: var(--text-2); font-size: 25rpx; font-weight: 650; line-height: 1.72; }
.action-list { display: flex; margin-top: 20rpx; flex-direction: column; gap: 12rpx; }
.action-item { display: flex; align-items: flex-start; padding: 16rpx; gap: 13rpx; border-radius: 20rpx; background: var(--surface-soft); }
.action-index { display: grid; width: 34rpx; height: 34rpx; flex: 0 0 auto; place-items: center; color: #fff; border-radius: 11rpx; font-size: 18rpx; font-weight: 900; background: linear-gradient(145deg, #4f8cff, #38bdf8); }
.answer-high .action-index { background: linear-gradient(145deg, #ef4444, #f97316); }
.action-item text { flex: 1; color: var(--text-2); font-size: 23rpx; line-height: 1.55; }
.fallback-note { margin-top: 18rpx; padding: 13rpx 15rpx; color: #f59e0b; border-radius: 16rpx; font-size: 19rpx; line-height: 1.5; background: rgba(245, 158, 11, .08); }
.answer-meta { margin-top: 18rpx; color: var(--text-3); font-size: 19rpx; }

.loading-card { display: flex; align-items: center; min-height: 112rpx; gap: 18rpx; color: var(--text-3); font-size: 22rpx; }
.typing { display: flex; gap: 7rpx; }
.typing i { width: 10rpx; height: 10rpx; border-radius: 50%; background: #4f8cff; animation: typing 1.1s ease-in-out infinite; }
.typing i:nth-child(2) { animation-delay: .16s; }
.typing i:nth-child(3) { animation-delay: .32s; }
.error-title { color: var(--text-1); font-size: 25rpx; font-weight: 850; }
.error-desc { margin-top: 10rpx; color: var(--text-3); font-size: 22rpx; line-height: 1.6; }
.retry-link { margin-top: 18rpx; color: var(--cyan); font-size: 23rpx; font-weight: 850; }
.answer-bottom { height: 20rpx; }

.chat-composer {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 16rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--stroke);
  background: var(--surface-strong);
  backdrop-filter: blur(30rpx);
}

.composer-inner { display: flex; align-items: center; min-height: 78rpx; padding: 7rpx 9rpx 7rpx 22rpx; gap: 12rpx; border: 1rpx solid var(--stroke-strong); border-radius: 999rpx; background: var(--surface-soft); }
.question-input { height: 62rpx; min-width: 0; flex: 1; color: var(--text-1); font-size: 23rpx; }
.question-placeholder { color: var(--text-3); }
.send-button { position: relative; display: grid; width: 60rpx; height: 60rpx; flex: 0 0 auto; place-items: center; border-radius: 50%; background: var(--stroke-strong); transition: transform .16s ease, background .16s ease; }
.send-button.active { background: linear-gradient(145deg, #4f8cff, #38bdf8); }
.send-button.active:active { transform: scale(.92); }
.send-arrow { width: 18rpx; height: 18rpx; border-top: 4rpx solid #fff; border-right: 4rpx solid #fff; transform: rotate(-45deg) translate(-2rpx, 2rpx); }
.composer-tip { margin-top: 8rpx; color: var(--text-3); font-size: 18rpx; text-align: center; }

@keyframes typing {
  0%, 65%, 100% { opacity: .35; transform: translateY(0); }
  32% { opacity: 1; transform: translateY(-7rpx); }
}
