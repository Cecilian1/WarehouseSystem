<view class="page-shell chat-page {{themeClass}}" style="--status-top: {{statusTop}}px; --nav-height: {{navHeight}}px;">
  <view class="custom-nav chat-nav" style="padding-top: {{statusTop}}px;">
    <view class="nav-back" bindtap="back"><x-icon type="back" size="{{32}}" /></view>
    <view class="nav-ai-mark"><view></view></view>
    <view class="nav-copy">
      <view class="page-title">{{preset.title}}</view>
      <view class="page-subtitle">{{preset.subtitle}}</view>
    </view>
  </view>

  <view class="chat-status">
    <view class="online-dot"></view>
    <text>回答仅以当前仓储数据库为事实来源</text>
  </view>

  <scroll-view class="chat-scroll" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{scrollTarget}}" scroll-with-animation>
    <block wx:for="{{messages}}" wx:key="id">
      <view wx:if="{{item.role === 'user'}}" id="message-{{item.id}}" class="question-row message-block fade-up">
        <view class="question-bubble">{{item.content}}</view>
        <view class="user-avatar">我</view>
      </view>

      <view wx:else id="message-{{item.id}}" class="answer-row message-block fade-up">
        <view class="assistant-avatar">
          <view class="avatar-eye left"></view>
          <view class="avatar-eye right"></view>
          <view class="avatar-smile"></view>
        </view>

        <view class="answer-wrap">
          <view wx:if="{{item.loading}}" class="answer-card loading-card">
            <view class="typing"><i></i><i></i><i></i></view>
            <text>正在核对最新仓储数据…</text>
          </view>

          <view wx:elif="{{item.error}}" class="answer-card error-card">
            <view class="error-title">暂时无法完成分析</view>
            <view class="error-desc">{{item.error}}</view>
            <button class="retry-link" data-id="{{item.id}}" data-question="{{item.question}}" bindtap="retry">重新分析</button>
          </view>

          <view wx:else class="answer-card answer-{{item.urgency.tone}}">
            <view class="answer-head">
              <view class="answer-title">AI 回答</view>
              <view class="urgency-pill urgency-{{item.urgency.tone}}"><i></i>{{item.urgency.label}}</view>
            </view>
            <view class="answer-summary">{{item.content}}</view>

            <view wx:if="{{item.bullets.length}}" class="action-list">
              <view class="action-item" wx:for="{{item.bullets}}" wx:for-item="point" wx:key="*this">
                <view class="action-index">{{index + 1}}</view>
                <text>{{point}}</text>
              </view>
            </view>

            <view wx:if="{{item.fallbackReason}}" class="fallback-note">{{item.fallbackReason}}</view>
            <view class="answer-meta">
              {{item.sourceLabel}} · {{item.generatedTime}}
              <text wx:if="{{item.grounded}}"> · 已校验数据</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view id="answer-bottom" class="answer-bottom"></view>
  </scroll-view>

  <view class="chat-composer">
    <view class="composer-inner">
      <input
        class="question-input"
        value="{{input}}"
        bindinput="inputQuestion"
        bindconfirm="ask"
        confirm-type="send"
        maxlength="240"
        placeholder="{{preset.placeholder}}"
        placeholder-class="question-placeholder"
      />
      <view class="send-button {{input && !sending ? 'active' : ''}}" bindtap="ask">
        <view class="send-arrow"></view>
      </view>
    </view>
    <view class="composer-tip">数据不足时 AI 会明确说明，不进行猜测</view>
  </view>
</view>
