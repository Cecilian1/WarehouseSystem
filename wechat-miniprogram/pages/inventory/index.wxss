.inventory-page .custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.nav-copy {
  min-width: 0;
  flex: 1;
}

.mode-button {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 6rpx;
  min-height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid var(--stroke);
  border-radius: 16rpx;
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 800;
  background: var(--surface);
}

.kpi-panel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  overflow: hidden;
  min-width: 0;
  margin-top: 22rpx;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-lg);
  background: var(--surface);
}

.kpi-item {
  min-width: 0;
  padding: 20rpx 18rpx;
}

.kpi-item:nth-child(odd) {
  border-right: 1rpx solid var(--stroke);
}

.kpi-item:nth-child(-n+2) {
  border-bottom: 1rpx solid var(--stroke);
}

.kpi-label {
  display: block;
  overflow: hidden;
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kpi-value {
  display: block;
  overflow: hidden;
  margin-top: 8rpx;
  color: var(--text-1);
  font-size: 36rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.kpi-value.urgent {
  color: var(--orange);
}

.search-card {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 88rpx;
  margin-top: 22rpx;
  padding: 8rpx 10rpx 8rpx 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-md);
  color: var(--text-2);
  background: var(--surface);
}

.search-icon {
  display: grid;
  flex: 0 0 auto;
  place-items: center;
}

.search-input {
  min-width: 0;
  flex: 1;
  height: 64rpx;
  color: var(--text-1);
  font-size: 26rpx;
  line-height: 64rpx;
}

.search-placeholder {
  color: var(--text-3);
}

.search-clear {
  display: grid;
  width: 40rpx;
  height: 40rpx;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 50%;
  color: var(--text-3);
  font-size: 28rpx;
  line-height: 1;
  background: var(--surface-soft);
}

.search-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  min-width: 96rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  background: linear-gradient(135deg, #38bdf8, #4f8cff);
}

.filter-panel {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
}

.filter-segment {
  display: flex;
  padding: 6rpx;
  border: 1rpx solid var(--stroke);
  border-radius: 16rpx;
  background: var(--surface-soft);
}

.filter-item {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 6rpx;
  border-radius: 12rpx;
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 800;
}

.filter-item.active {
  color: #fff;
  background: linear-gradient(135deg, #38bdf8, #4f8cff);
}

.inventory-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  min-height: 80rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.action-btn text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-btn.ghost {
  color: var(--text-1);
  border: 1rpx solid var(--stroke);
  background: var(--surface);
}

.action-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #38bdf8, #4f8cff);
}

.inventory-list {
  display: grid;
  gap: 16rpx;
  min-width: 0;
  margin-top: 22rpx;
}

.inventory-list.card {
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.inventory-list.list {
  grid-template-columns: 1fr;
}
