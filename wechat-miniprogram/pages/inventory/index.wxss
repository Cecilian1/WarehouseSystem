.inventory-page .custom-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.metric {
  text-align: center;
}

.metric text {
  display: block;
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 900;
}

.metric small {
  display: block;
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 21rpx;
}

.mode-button {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 68rpx;
  padding: 0 18rpx;
  border-radius: var(--radius-sm);
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 900;
  background: var(--surface);
}

.search-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 92rpx;
  margin-top: 22rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-md);
  color: var(--text-2);
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}

.search-card input {
  flex: 1;
  color: var(--text-1);
  font-size: 28rpx;
}

.search-card button {
  color: var(--text-2);
  font-size: 26rpx;
  font-weight: 900;
}

.chip-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.chip-scroll.compact {
  margin-top: 14rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  height: 62rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  color: var(--text-3);
  font-size: 25rpx;
  font-weight: 800;
  background: var(--surface);
}

.chip.sort {
  min-width: 150rpx;
}

.chip.active {
  color: #fff;
  background: linear-gradient(135deg, var(--blue), #6c63ff);
  box-shadow: 0 10rpx 26rpx rgba(79, 140, 255, .24);
}

.inventory-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 22rpx;
}

.inventory-list {
  display: grid;
  gap: 18rpx;
  margin-top: 24rpx;
}

.inventory-list.card {
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.inventory-list.list {
  grid-template-columns: 1fr;
}
