.custom-nav {
  display: flex;
  align-items: center;
}

.board-card {
  margin-top: 24rpx;
}

.board-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.board-chip {
  display: grid;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 auto;
  place-items: center;
  border-radius: var(--radius-sm);
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
  background: linear-gradient(135deg, var(--blue), #6c63ff);
}

.board-name {
  color: var(--text-1);
  font-size: 30rpx;
  font-weight: 900;
}

.board-sub {
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 23rpx;
}

.board-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-top: 20rpx;
}

.board-grid view {
  padding: 14rpx;
  border-radius: 20rpx;
  text-align: center;
  background: var(--surface-soft);
}

.board-grid small {
  display: block;
  color: var(--text-3);
  font-size: 20rpx;
}

.board-grid text {
  display: block;
  margin-top: 6rpx;
  color: var(--text-1);
  font-size: 24rpx;
  font-weight: 900;
}

.uptime-card {
  margin-top: 18rpx;
}

.uptime-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.score-ring {
  display: grid;
  width: 108rpx;
  height: 108rpx;
  flex: 0 0 auto;
  place-items: center;
  border: 9rpx solid rgba(79, 140, 255, .18);
  border-top-color: var(--blue);
  border-right-color: var(--blue);
  border-radius: 50%;
}

.score-ring text {
  color: var(--text-1);
  font-size: 26rpx;
  font-weight: 900;
}

.uptime-title {
  color: var(--text-1);
  font-size: 28rpx;
  font-weight: 900;
}

.uptime-desc {
  margin-top: 6rpx;
  color: var(--text-3);
  font-size: 23rpx;
}

.device-list {
  display: grid;
  gap: 18rpx;
  margin-top: 24rpx;
}

.device-row {
  display: flex;
  gap: 18rpx;
}

.device-icon {
  display: grid;
  width: 82rpx;
  height: 82rpx;
  flex: 0 0 auto;
  place-items: center;
  border-radius: var(--radius-sm);
  color: var(--blue);
  background: rgba(79, 140, 255, .14);
}

.device-icon.warning {
  color: var(--orange);
  background: rgba(245, 158, 11, .16);
}

.device-icon.offline {
  color: var(--red);
  background: rgba(239, 68, 68, .16);
}

.device-main {
  min-width: 0;
  flex: 1;
}

.device-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.device-name {
  color: var(--text-1);
  font-size: 31rpx;
  font-weight: 900;
}

.device-code,
.device-meta {
  margin-top: 8rpx;
  color: var(--text-3);
  font-size: 23rpx;
}

.device-data {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.device-data view {
  padding: 14rpx;
  border-radius: 20rpx;
  background: var(--surface-soft);
  text-align: center;
}

.device-data text,
.device-data small {
  display: block;
}

.device-data text {
  color: var(--text-1);
  font-size: 27rpx;
  font-weight: 900;
}

.device-data small {
  margin-top: 4rpx;
  color: var(--text-3);
  font-size: 20rpx;
}

.device-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.device-actions button {
  height: 64rpx;
  border-radius: 20rpx;
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
  line-height: 64rpx;
  background: var(--surface-soft);
}

.add-device {
  margin-top: 24rpx;
}
