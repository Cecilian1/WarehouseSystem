<view class="page-shell devices-page {{themeClass}}" style="--status-top: {{statusTop}}px; --nav-height: {{navHeight}}px;">
  <view class="custom-nav" style="padding-top: {{statusTop}}px;">
    <view class="nav-back" bindtap="back"><x-icon type="back" size="{{34}}" /></view>
    <view>
      <view class="page-title">设备管理</view>
      <view class="page-subtitle">开发板、摄像头与传感器状态</view>
    </view>
  </view>

  <view class="summary-card">
    <view class="summary-head">
      <view class="board-chip">LA</view>
      <view class="summary-copy">
        <view class="board-name">{{board.name}}</view>
        <view class="board-sub">{{board.model}} · {{board.lastSync}}</view>
      </view>
      <status-tag label="{{board.state === 'online' ? '在线' : board.state === 'warning' ? '需关注' : '离线'}}" tone="{{board.state}}" />
    </view>
    <view class="summary-grid">
      <view>
        <small>在线率</small>
        <text>{{avgUptime}}%</text>
      </view>
      <view>
        <small>设备数</small>
        <text>{{devices.length}}</text>
      </view>
      <view>
        <small>正常</small>
        <text>{{onlineCount}}</text>
      </view>
      <view>
        <small>需关注</small>
        <text>{{attentionCount}}</text>
      </view>
    </view>
  </view>

  <view class="device-list">
    <view wx:for="{{devices}}" wx:key="id" class="device-card">
      <view class="device-top">
        <view class="device-icon {{item.state}}"><x-icon type="device" size="{{34}}" /></view>
        <view class="device-main">
          <view class="device-name">{{item.name}}</view>
          <view class="device-code">{{item.type}} · {{item.model}}</view>
        </view>
        <view class="device-tag">
          <status-tag label="{{item.state === 'online' ? '在线' : item.state === 'warning' ? '需关注' : '离线'}}" tone="{{item.state}}" />
        </view>
      </view>
      <view class="device-facts">
        <view>
          <small>状态</small>
          <text>{{item.value}}</text>
        </view>
        <view>
          <small>在线率</small>
          <text>{{item.uptime}}%</text>
        </view>
        <view>
          <small>最近同步</small>
          <text>{{item.lastSync}}</text>
        </view>
      </view>
      <view wx:if="{{item.canSwitch}}" class="device-actions">
        <view class="device-action" data-id="{{item.id}}" bindtap="switchDevice">设为当前设备</view>
        <view class="device-action ghost" bindtap="unbindDevice">解除绑定</view>
      </view>
    </view>
  </view>

  <view class="primary-button add-device" bindtap="addDevice">
    <x-icon type="add" size="{{34}}" />
    <text>添加新设备</text>
  </view>
</view>
