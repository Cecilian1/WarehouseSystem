.home-page {
  padding-right: 24rpx;
  padding-left: 24rpx;
}

.home-hero {
  position: relative;
  margin: 0 -24rpx 20rpx;
  padding: 0 32rpx 34rpx;
  overflow: hidden;
  color: #fff;
  border-radius: 0 0 30rpx 30rpx;
  background: linear-gradient(145deg, #4f8cff, #6c63ff);
  box-shadow: 0 16rpx 36rpx rgba(79, 140, 255, .22);
}

.home-hero::before {
  position: absolute;
  right: -110rpx;
  bottom: -96rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, .2);
  background: rgba(255, 255, 255, .06);
  content: "";
}

.custom-nav {
  display: flex;
  align-items: center;
  min-height: 104rpx;
}

.hello {
  font-size: 25rpx;
  opacity: .78;
}

.hero-title {
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.hero-copy {
  position: relative;
  z-index: 1;
  max-width: 560rpx;
  margin-top: 14rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.5;
}

.status-strip {
  width: 100%;
  margin: 20rpx 0;
  white-space: nowrap;
}

.status-chip-wrap {
  display: inline-block;
  width: 208rpx;
  margin-right: 14rpx;
  white-space: normal;
  vertical-align: top;
}

.status-chip-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.status-chip-dot {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--text-3);
}

.status-chip-dot.online {
  background: var(--green);
}

.status-chip-dot.warning {
  background: var(--orange);
}

.status-chip-dot.offline {
  background: var(--red);
}

.status-chip-label {
  overflow: hidden;
  color: var(--text-3);
  font-size: 21rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-chip-value {
  margin-top: 8rpx;
  overflow: hidden;
  color: var(--text-1);
  font-size: 26rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-card,
.env-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.card-label {
  color: var(--text-3);
  font-size: 23rpx;
  font-weight: 700;
}

.card-title {
  margin-top: 8rpx;
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 900;
}

.card-sub {
  margin-top: 8rpx;
  color: var(--text-3);
  font-size: 23rpx;
}

.device-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 18rpx;
}

.device-grid view {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 58rpx;
  padding: 0 14rpx;
  border-radius: 18rpx;
  background: var(--surface-soft);
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--green);
}

.device-grid text {
  overflow: hidden;
  color: var(--text-2);
  font-size: 23rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.env-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
}

.env-desc {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, .78);
  font-size: 23rpx;
}

.env-state {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 23rpx;
  font-weight: 900;
  background: rgba(255, 255, 255, .18);
}

.env-values {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.env-values view {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  gap: 4rpx;
  color: #fff;
  padding: 16rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .12);
}

.env-values text {
  font-size: 44rpx;
  font-weight: 900;
}

.env-values small {
  font-size: 22rpx;
  opacity: .78;
}

.metric-grid-2 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.metric2-label {
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 700;
}

.metric2-value-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 10rpx;
}

.metric2-value {
  font-size: 38rpx;
  font-weight: 900;
}

.metric2-value.tone-blue {
  color: var(--blue);
}

.metric2-value.tone-cyan {
  color: var(--cyan);
}

.metric2-value.tone-orange {
  color: var(--orange);
}

.metric2-value.tone-red {
  color: var(--red);
}

.metric2-unit {
  color: var(--text-3);
  font-size: 22rpx;
}

.metric2-change {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  font-weight: 800;
}

.metric2-change.up {
  color: var(--green);
}

.metric2-change.down {
  color: var(--red);
}

.category-row {
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.donut-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  flex: 0 0 auto;
}

.donut-ring {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.donut-hole {
  position: absolute;
  inset: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--surface-strong);
}

.donut-hole text {
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 900;
}

.donut-hole small {
  color: var(--text-3);
  font-size: 20rpx;
}

.category-legend {
  display: grid;
  flex: 1;
  gap: 14rpx;
}

.category-legend view {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.category-legend i {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.category-legend text {
  flex: 1;
  color: var(--text-3);
  font-size: 24rpx;
}

.category-legend b {
  color: var(--text-1);
  font-size: 26rpx;
}

.chart-title {
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 900;
}

.stock-trend-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 220rpx;
  margin-top: 24rpx;
}

.stock-trend-col {
  display: flex;
  align-items: center;
  flex: 1;
  flex-direction: column;
  justify-content: flex-end;
}

.stock-bars {
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 160rpx;
}

.inbound-bar,
.outbound-bar {
  width: 12rpx;
  border-radius: 999rpx;
}

.inbound-bar {
  background: linear-gradient(180deg, #22c55e, rgba(34, 197, 94, .18));
}

.outbound-bar {
  background: linear-gradient(180deg, #38bdf8, rgba(56, 189, 248, .18));
}

.stock-trend-col text {
  margin-top: 10rpx;
  color: var(--text-3);
  font-size: 20rpx;
}

.chart-legend {
  display: flex;
  gap: 26rpx;
  margin-top: 18rpx;
  color: var(--text-3);
  font-size: 24rpx;
}

.chart-legend view {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.chart-legend i {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.chart-legend .inbound {
  background: var(--green);
}

.chart-legend .outbound {
  background: var(--cyan);
}

.trend-insight {
  margin-top: 16rpx;
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 700;
}

.recognition-list {
  display: grid;
  gap: 14rpx;
}

.recognition-row {
  display: flex;
  align-items: center;
}

.recognition-name {
  color: var(--text-1);
  font-size: 28rpx;
  font-weight: 900;
}

.recognition-type {
  margin-left: 10rpx;
  padding: 2rpx 14rpx;
  border-radius: var(--radius-pill);
  font-size: 21rpx;
  font-weight: 800;
}

.recognition-type.inbound {
  color: var(--green);
  background: rgba(34, 197, 94, .16);
}

.recognition-type.outbound {
  color: var(--cyan);
  background: rgba(56, 189, 248, .16);
}

.recognition-meta {
  margin-top: 8rpx;
  color: var(--text-3);
  font-size: 22rpx;
}

.fresh-stack {
  display: flex;
  height: 24rpx;
  overflow: hidden;
  border-radius: var(--radius-pill);
  background: var(--surface-soft);
}

.fresh-segment {
  min-width: 8rpx;
  height: 100%;
}

.fresh-legend {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.fresh-legend view {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.fresh-legend i {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.fresh-legend text {
  color: var(--text-3);
  font-size: 24rpx;
}

.fresh-legend b {
  color: var(--text-1);
  font-size: 28rpx;
}

.reminder-list {
  display: grid;
  gap: 16rpx;
}

.reminder-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.reminder-icon {
  display: grid;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 24rpx;
  color: var(--cyan);
  background: rgba(56, 189, 248, .15);
}

.reminder-icon.critical {
  color: var(--red);
  background: rgba(239, 68, 68, .16);
}

.reminder-icon.warning {
  color: var(--orange);
  background: rgba(245, 158, 11, .16);
}

.reminder-title {
  color: var(--text-1);
  font-size: 29rpx;
  font-weight: 900;
}

.reminder-desc {
  margin-top: 8rpx;
  color: var(--text-3);
  font-size: 24rpx;
  line-height: 1.42;
}

.suggestion {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  color: var(--text-2);
  font-size: 27rpx;
  line-height: 1.55;
}

.suggestion + .suggestion {
  margin-top: 18rpx;
}

.suggestion-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--blue);
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin: 24rpx 0 12rpx;
}

.quick-card {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
  min-height: 108rpx;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-sm);
  color: var(--text-2);
  font-size: 23rpx;
  font-weight: 900;
  background: var(--surface);
  box-shadow: var(--shadow-soft);
}
