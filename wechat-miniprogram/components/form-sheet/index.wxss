.sheet-mask {
  position: fixed;
  z-index: 90;
  inset: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(10, 14, 20, .5);
  backdrop-filter: blur(10rpx);
}

.sheet-panel {
  width: 100%;
  padding: 18rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: var(--radius-md) var(--radius-md) 0 0;
  border: 1rpx solid var(--stroke);
  background: var(--surface-strong);
  box-shadow: var(--shadow);
  backdrop-filter: blur(24px);
}

.sheet-handle {
  width: 80rpx;
  height: 8rpx;
  margin: 0 auto 26rpx;
  border-radius: 99rpx;
  background: var(--stroke-strong);
}

.sheet-title {
  margin-bottom: 20rpx;
  color: var(--text-1);
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
}

.form-body {
  max-height: 60vh;
}

.form-row {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--text-3);
  font-size: 24rpx;
  font-weight: 700;
}

.form-input {
  min-height: 80rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-sm);
  color: var(--text-1);
  font-size: 28rpx;
  background: var(--surface-soft);
}

.form-chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.form-chip {
  min-width: 96rpx;
  height: 62rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-pill);
  color: var(--text-3);
  font-size: 25rpx;
  font-weight: 800;
  line-height: 62rpx;
  text-align: center;
  background: var(--surface-soft);
}

.form-chip.active {
  color: #fff;
  border-color: transparent;
  background: linear-gradient(135deg, var(--blue), #6c63ff);
}

.form-stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  width: 240rpx;
}

.stepper-btn {
  display: grid;
  width: 60rpx;
  height: 60rpx;
  place-items: center;
  border: 1rpx solid var(--stroke);
  border-radius: var(--radius-sm);
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 900;
  background: var(--surface-soft);
}

.stepper-value {
  min-width: 80rpx;
  color: var(--text-1);
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
}

.sheet-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 8rpx;
}
