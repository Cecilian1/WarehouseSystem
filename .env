# 芯鲜管家 WarehouseSystem —— 统一环境配置模板
#
# 用法：复制为 .env（不入库），按需修改后：
#   - 后端：deploy/run_server_on_windows.ps1 / deploy/run_backend.sh 会自动读取本文件
#   - Web前端：web-frontend 已通过 vite.config.ts 的 envDir 指向仓库根目录，直接读取本文件
#   - 小程序：wechat-miniprogram/config/index.js 无法在运行时读取 .env（微信小程序无
#     Node运行时），修改下面 MINIPROGRAM_* 后需执行一次同步脚本：
#       node scripts/sync-miniprogram-config.js
#     该脚本会把对应值写回 wechat-miniprogram/config/index.js

# ========== 后端 API 服务 (backend/api_service) ==========
# SQLite数据库文件路径
WAREHOUSE_DB_PATH=data/warehousekeeper-server.db
WAREHOUSE_LATEST_FRAME_PATH=data/warehousekeeper/frames/latest.jpg
# 开发板上游数据源地址（本地联调时若无开发板可留空或填一个当前不可达的地址）
WAREHOUSE_BOARD_SOURCE_URL=http://10.28.32.254:8000
# 从开发板同步数据的状态文件
WAREHOUSE_COLLECTOR_STATE_PATH=data/collector-state.json
# 同步间隔（秒）
WAREHOUSE_SYNC_INTERVAL_SEC=5
# 是否允许演示登录（跳过微信code2Session）
WAREHOUSE_ALLOW_DEMO_LOGIN=true
# CORS 允许的来源，* 表示不限制
WAREHOUSE_CORS_ORIGINS=*
# 微信登录 (code2Session) 所需的服务端凭证；不设置时 /api/auth/wechat-login 之外的接口仍可用
WAREHOUSE_WECHAT_APPID=wx0ebaedfc301b36a4
WAREHOUSE_WECHAT_APP_SECRET=

# ========== Web 前端 (web-frontend, Vite) ==========
# false = 请求真实后端接口；true = 使用内置Mock数据
VITE_USE_MOCK=false
VITE_API_BASE_URL=/api
# dev server 把 /api 代理到的目标地址
VITE_DEV_API_TARGET=http://10.28.32.254:8000
# Web 开发服务器通过上方代理访问 API；WebSocket 需直接连接开发板。
VITE_WS_URL=ws://10.28.32.254:8000/ws/notify

# ========== 微信小程序 (wechat-miniprogram) ==========
# 小程序 AppID（微信开发者工具项目标识，对应 project.config.json 的 appid）
MINIPROGRAM_APPID=wx0ebaedfc301b36a4
# 小程序请求开发板 API。手机和电脑应与开发板处于同一局域网。
MINIPROGRAM_BASE_URL=http://10.28.32.254:8000/api
MINIPROGRAM_WS_URL=ws://10.28.32.254:8000/ws/notify
